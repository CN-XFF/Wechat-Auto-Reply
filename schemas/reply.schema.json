{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "requires_confirmation", "risk_categories", "reason"],
  "properties": {
    "reply": {"type": "string", "minLength": 1, "maxLength": 120},
    "requires_confirmation": {"type": "boolean"},
    "risk_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["argument", "breakup", "money", "privacy", "meeting_promise", "health_emergency", "third_party_sensitive", "self_harm", "none"]
      }
    },
    "reason": {"type": "string", "maxLength": 180}
  }
}
